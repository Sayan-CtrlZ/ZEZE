# ==============================================================================
# ZEZE Backend - Environment Configuration
# ==============================================================================

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key (Required for AI Chat & LLM Extraction fallback)
# Obtain a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# CORS Allowed Origins (Comma-separated list or leave as wildcard *)
# For production, set to your frontend domain (e.g., https://your-zeze-frontend.vercel.app)
CORS_ORIGINS=*
