# ==============================================================================
# ZEZE MED AI - Frontend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Inference Backend URL (Do NOT include trailing slash)
# ------------------------------------------------------------------------------
# Local development: http://localhost:8000
# Production: https://zeze-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Firebase Authentication & Cloud Firestore Configuration
# ------------------------------------------------------------------------------
# DATA STORAGE POLICY:
# Firebase Auth and Firestore are ONLY used for user account identity (email, password,
# user name, and practitioner / profile details).
# ZERO medical document scans, lab slips, OCR extracts, or patient risk analyses
# are stored in Firebase or Firestore.
#
# Get these values from your Firebase Console -> Project Settings -> General -> Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
