# ==============================================================================
# ZEZE - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.next/
**/.next/
out/
build/
dist/
.turbo/
**/.turbo/
*.tsbuildinfo
next-env.d.ts.bak

# Logs & Package Managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------------------------------------------
# Python Backend & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments (Any Location)
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
env.bak/
venv.bak/

# Testing, Linting & Coverage
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
test-results/
playwright-report/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL FOR SECURITY)
# ------------------------------------------------------------------------------
.env
.env*
**/.env
**/.env*
*.env
*.env.*

# Explicitly whitelist documentation and example env files
!.env.example
!**/.env.example
!.env.local.example
!**/.env.local.example
!Client/.env.example
!Backend/.env.example

# SSL Keys, Certificates & Credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
secrets/
**/*serviceAccountKey*.json

# ------------------------------------------------------------------------------
# IDE, Editors & Operating Systems
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# AI Agent, Editor & Scratch Dirs
.gemini/
.antigravity/
uploads/
temp_uploads/
scratch/
browser/
.tempmediaStorage/
*.tmp
*.temp

