# ==============================================================================
# ZEZE - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# Logs & Package Managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------------------------------------------
# Python Backend & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL FOR DEPLOYMENT)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
Client/.env
Client/.env.local
Backend/.env

# Allow public example environment files
!.env.example
!.env.local.example
!Client/.env.example
!Backend/.env.example

# ------------------------------------------------------------------------------
# IDE, Editors & Operating Systems
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# Temporary Files, Scratch & Upload Dumps
# ------------------------------------------------------------------------------
uploads/
temp_uploads/
scratch/
browser/
.tempmediaStorage/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# Large Datasets & Archives
# (Note: cardio_model.joblib is tracked for zero-downtime deployment inference)
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.7z
*.rar
*.sqlite
*.sqlite3
*.db
datasets/
data/
